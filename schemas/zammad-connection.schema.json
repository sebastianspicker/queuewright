{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zammad-connection.schema.json",
  "title": "Zammad runtime connection contract v1",
  "description": "Runtime-only input for a future connected adapter. Secret-bearing instances must never be persisted, exported, or logged.",
  "x_contract_version": 1,
  "type": "object",
  "required": ["origin", "api_token"],
  "properties": {
    "origin": {
      "type": "string",
      "minLength": 1,
      "format": "uri",
      "pattern": "^https://(?:(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?|\\[[0-9A-Fa-f:.]+\\])(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$"
    },
    "api_token": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S+$",
      "writeOnly": true
    },
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "default": 10},
    "allow_private_origin": {"type": "boolean", "default": false},
    "trust_environment": {"type": "boolean", "default": false}
  },
  "additionalProperties": false
}
