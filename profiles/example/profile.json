      "service_code": null
    },
    "scenarios": [
      {"key":"seed-general","number":1,"kind":"seed","group":"service_general","customer":"customer","agent":"service","label":"General request","expected_tags":["example/uat"]}
    ],
    "access_matrix": {
      "seed_keys": ["seed-general"]
