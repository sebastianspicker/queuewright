{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/queuewright-project-v2.schema.json",
  "title": "Local Queuewright Studio project V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_schema_version", "id", "name", "target_schema_version", "workbook", "extensions", "bundle"],
  "properties": {
    "project_schema_version": {"const": "2.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "target_schema_version": {"enum": ["1.0", "1.1"]},
    "workbook": {
      "description": "Editable input is organization plus each capability completion and enabled state. services, policies, UAT, and registry metadata are compiler-owned exported mirrors.",
      "type": "object", "additionalProperties": false,
      "required": ["organization", "capability_decisions"],
      "properties": {
        "organization": {"$ref": "#/$defs/safe_object"},
        "services": {
          "type": "array",
          "items": {"$ref": "#/$defs/safe_object"}
        },
        "policies": {"$ref": "#/$defs/safe_object"},
        "capability_decisions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "organization",
            "service-topology",
            "organizations-customers",
            "roles-acl",
            "identity-security",
            "fields-core-workflows",
            "calendars-sla",
            "tags",
            "overviews-macros-templates-text-modules-checklists",
            "triggers-schedulers-report-profiles",
            "channels-postmaster-signatures",
            "webhooks-integrations",
            "knowledge-base",
            "time-accounting",
            "privacy-retention",
            "branding-ticket-settings",
            "ai",
            "uat-evidence",
            "platform-dr"
          ],
          "properties": {
            "organization": {"$ref": "#/$defs/capability_decision"},
            "service-topology": {"$ref": "#/$defs/capability_decision"},
            "organizations-customers": {"$ref": "#/$defs/capability_decision"},
            "roles-acl": {"$ref": "#/$defs/capability_decision"},
            "identity-security": {"$ref": "#/$defs/capability_decision"},
            "fields-core-workflows": {"$ref": "#/$defs/capability_decision"},
            "calendars-sla": {"$ref": "#/$defs/capability_decision"},
            "tags": {"$ref": "#/$defs/capability_decision"},
            "overviews-macros-templates-text-modules-checklists": {"$ref": "#/$defs/capability_decision"},
            "triggers-schedulers-report-profiles": {"$ref": "#/$defs/capability_decision"},
            "channels-postmaster-signatures": {"$ref": "#/$defs/capability_decision"},
            "webhooks-integrations": {"$ref": "#/$defs/capability_decision"},
            "knowledge-base": {"$ref": "#/$defs/capability_decision"},
            "time-accounting": {"$ref": "#/$defs/capability_decision"},
            "privacy-retention": {"$ref": "#/$defs/capability_decision"},
            "branding-ticket-settings": {"$ref": "#/$defs/capability_decision"},
            "ai": {"$ref": "#/$defs/capability_decision"},
            "uat-evidence": {"$ref": "#/$defs/capability_decision"},
            "platform-dr": {"$ref": "#/$defs/capability_decision"}
          }
        },
        "uat": {"$ref": "#/$defs/safe_object"}
      }
    },
    "extensions": {"$ref": "#/$defs/safe_object"},
    "bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "manifest", "resource_ownership", "feature_state"],
      "properties": {
        "profile": {"$ref": "queuewright-profile.schema.json"},
        "manifest": {"$ref": "queuewright-desired-state.schema.json"},
        "resource_ownership": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(groups|organizations|roles|agents|customers|tags|overviews|macros|checklist_templates|triggers|jobs|report_profiles|object_manager_fields|core_workflows|uat_scenarios):.+$"
          },
          "additionalProperties": {
            "$ref": "queuewright-project.schema.json#/$defs/resource_owner"
          }
        },
        "feature_state": {
          "$ref": "queuewright-project.schema.json#/properties/feature_state"
        }
      }
    }
  },
  "$defs": {
    "capability_decision": {
      "description": "completion and enabled are editable. Registry metadata is accepted for round trips and regenerated by compilation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["completion", "enabled"],
      "properties": {
        "completion": {"enum": ["decision_required", "ready", "blocked"]},
        "delivery": {"enum": ["automated", "guided_manual", "verify_only", "unsupported"]},
        "risk": {"enum": ["low", "medium", "high", "critical"]},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/capability_id"}
        },
        "enabled": {"type": "boolean"}
      }
    },
    "capability_id": {
      "enum": [
        "organization",
        "service-topology",
        "organizations-customers",
        "roles-acl",
        "identity-security",
        "fields-core-workflows",
        "calendars-sla",
        "tags",
        "overviews-macros-templates-text-modules-checklists",
        "triggers-schedulers-report-profiles",
        "channels-postmaster-signatures",
        "webhooks-integrations",
        "knowledge-base",
        "time-accounting",
        "privacy-retention",
        "branding-ticket-settings",
        "ai",
        "uat-evidence",
        "platform-dr"
      ]
    },
    "safe_object": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/safe_property_name"},
      "additionalProperties": {"$ref": "#/$defs/safe_value"}
    },
    "safe_property_name": {
      "allOf": [
        {
          "not": {
            "pattern": "(^|[^A-Za-z0-9]|[a-z0-9](?=[A-Z]))([Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?|[Ee][Nn][Vv]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Ss][Ee][Ss][Ss][Ii][Oo][Nn]|[Tt][Oo][Kk][Ee][Nn])(?=$|[^A-Za-z0-9]|[A-Z])"
          }
        },
        {
          "not": {
            "allOf": [
              {"pattern": "(^|[^A-Za-z0-9]|[a-z0-9](?=[A-Z]))[Aa][Pp][Ii](?=$|[^A-Za-z0-9]|[A-Z])"},
              {"pattern": "(^|[^A-Za-z0-9]|[a-z0-9](?=[A-Z]))[Kk][Ee][Yy](?=$|[^A-Za-z0-9]|[A-Z])"}
            ]
          }
        },
        {
          "not": {
            "allOf": [
              {"pattern": "(^|[^A-Za-z0-9]|[a-z0-9](?=[A-Z]))[Pp][Rr][Ii][Vv][Aa][Tt][Ee](?=$|[^A-Za-z0-9]|[A-Z])"},
              {"pattern": "(^|[^A-Za-z0-9]|[a-z0-9](?=[A-Z]))[Kk][Ee][Yy](?=$|[^A-Za-z0-9]|[A-Z])"}
            ]
          }
        }
      ]
    },
    "safe_value": {"oneOf": [
      {"type": "null"}, {"type": "boolean"}, {"type": "number"},
      {"type": "string", "pattern": "^(?!.*://).*"},
      {"type": "array", "items": {"$ref": "#/$defs/safe_value"}},
      {"$ref": "#/$defs/safe_object"}
    ]}
  }
}
